# Jobright credentials used by Greezik when an automatic redirect to
# /jobs/recommend does not happen on first load.
JOBRIGHT_EMAIL=you@example.com
JOBRIGHT_PASSWORD=your-password

# How long to wait (seconds) after the initial page load before deciding
# whether the site redirected us to /jobs/recommend.
POST_LOAD_WAIT_SECONDS=3

# How long to wait (seconds) for the post-login redirect to /jobs/recommend.
REDIRECT_WAIT_SECONDS=15

# Where applied job URLs are appended (JSON Lines, one record per line).
# Each record carries company_slug + role_title + applied_at, which the
# bot uses for the per-company dedup window below.
APPLIED_URLS_FILE=applied_jobs.jsonl

# Where SKIPPED jobs (non-Greenhouse, judge-rejected, recently-applied,
# user-cancelled after a submit failure, etc.) are appended. Each
# record carries a ``skip_reason`` string explaining why we bailed.
SKIPPED_URLS_FILE=skipped_jobs.jsonl

# Per-company dedup window: if Greezik already applied to this
# company within COMPANY_DEDUP_DAYS days, the new opening is logged
# to skipped_jobs.jsonl and not re-bid. Set to 0 to disable. Default 3.
COMPANY_DEDUP_DAYS=3

# Set to "false" to fill the Greenhouse form but NOT click "Submit
# application" -- useful for reviewing answers before going live.
# Default true (live runs really submit).
SUBMIT_GREENHOUSE=true

# Persistent Playwright Chromium profile directory.
# Keeping this around lets you stay signed in between runs.
BROWSER_PROFILE_DIR=.pw_profile

# Default per-action timeout (milliseconds) for clicks, waits, etc.
ACTION_TIMEOUT_MS=15000


# ---------------------------------------------------------------------------
# Autobid / autofill profile -- used when filling external job applications
# (currently Greenhouse only). All values are optional except the basics; an
# empty value just means we skip that field.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Greenhouse "Verify your email" handling
# ---------------------------------------------------------------------------
# Some Greenhouse forms send a one-time security code to the candidate's
# email address before the application is finalized. Greezik can read
# this email automatically over Gmail IMAP and paste the code back into
# the application form.
#
# Setup (Gmail only):
#   1. Enable 2-Step Verification on the Google account.
#   2. Visit https://myaccount.google.com/apppasswords and create a new
#      "App password" (any name works). Google returns a 16-char password.
#   3. Paste that 16-char password into GMAIL_APP_PASSWORD below (with
#      or without spaces -- Greezik strips them).
#
# If GMAIL_APP_PASSWORD is left blank, Greezik will skip the verify-email
# flow and report a submission error when a code prompt appears.
GMAIL_ADDRESS=tilermichaeljung@gmail.com
GMAIL_APP_PASSWORD=qyrv ioje kxxk ywdd
# How long (seconds) to poll Gmail for the security-code email. Default 90.
EMAIL_VERIFY_TIMEOUT_SECONDS=15

# Optional outbound proxy for the Chromium browser. Accepted formats:
#   host:port                          (no auth)
#   host:port:user:pass                (auth, user-style)
#   user:pass@host:port                (auth, URL-style)
#   http://host:port                   (explicit scheme)
#   http://user:pass@host:port         (explicit scheme + auth)
#   socks5://host:port                 (SOCKS5 also supported)
# Leave blank for direct connection.
BROWSER_PROXY=

APPLICANT_FIRST_NAME=David
APPLICANT_LAST_NAME=Jacinto
APPLICANT_PREFERRED_NAME=David
APPLICANT_EMAIL=jacintoodavid@gmail.com
APPLICANT_PHONE=+15551234567
APPLICANT_COUNTRY=United States
APPLICANT_LINKEDIN=https://www.linkedin.com/in/your-handle
APPLICANT_WEBSITE=
APPLICANT_GITHUB=
APPLICANT_CITY=
APPLICANT_STATE=
# Two-letter postal abbreviation for STATE (e.g. "TX"). Used for any
# field that asks for "City, State" -- the autobid combines this with
# APPLICANT_CITY into "<city>, <state_abbr>". If empty, plain CITY
# is used and combined-format fields will only show the city.
APPLICANT_STATE_ABBR=
APPLICANT_POSTAL_CODE=

# Used for typeahead "Location (City)" comboboxes that ask the candidate to
# pick a single city from a server-fetched list. Often differs from the
# physical home city. If empty, APPLICANT_CITY is used.
APPLICANT_LOCATION_CITY=

# Education (used for Greenhouse education sections: School / Degree /
# Discipline / Start year / End year + optional months). All optional.
APPLICANT_SCHOOL=
APPLICANT_DEGREE=
APPLICANT_DISCIPLINE=
APPLICANT_EDUCATION_START_YEAR=
APPLICANT_EDUCATION_END_YEAR=
# Some Greenhouse education sections also have separate "Start date month"
# / "End date month" selects. Use full month names (e.g. "September") --
# the typeahead matches against the rendered option text.
APPLICANT_EDUCATION_START_MONTH=
APPLICANT_EDUCATION_END_MONTH=

# Path to your resume file. Relative to the project root or absolute.
# Common formats accepted by Greenhouse: pdf, doc, docx.
APPLICANT_RESUME_PATH=./resume.pdf

# OPTIONAL: folder of candidate resumes (PDFs). When set, Greezik will:
#   1. Save each job description to logs/jds/<provider>_<token>.txt
#   2. Run a "BID/SKIP" judge against the JD (filters out manager / security /
#      hardware / clearance-only / intern roles + low-fit JDs).
#   3. If BID, score every PDF in this folder against the JD and upload the
#      best match instead of APPLICANT_RESUME_PATH.
# Leave blank to keep using the single APPLICANT_RESUME_PATH for every job.
APPLICANT_RESUMES_DIR=

# Voluntary self-identification answers (must match the option label shown
# in Greenhouse's dropdowns; "Decline To Self Identify" is a safe default).
APPLICANT_GENDER=Decline To Self Identify
APPLICANT_HISPANIC_ETHNICITY=No
APPLICANT_RACE=Decline To Self Identify
APPLICANT_VETERAN_STATUS=I am not a protected veteran
APPLICANT_DISABILITY_STATUS=I do not want to answer

# Some employers use a separate "U.S. Standard Demographic" survey on top
# of the EEO/voluntary self-id ones above. Multi-value fields accept a
# comma-separated list (e.g. "Asian, White"). Leave blank to let the AI
# pick a sensible default at fill-time.
APPLICANT_GENDER_IDENTITY=
APPLICANT_RACIAL_ETHNIC_BACKGROUND=
APPLICANT_SEXUAL_ORIENTATION=
APPLICANT_TRANSGENDER=
# "Do you have a disability or chronic condition...?" / "Are you a
# veteran or active member of the U.S. Armed Forces?". Short answers
# work best ("Yes" / "No") -- the autobid uses substring matching to
# find the matching option on the form.
APPLICANT_DISABILITY_CHRONIC=
APPLICANT_VETERAN_ACTIVE=

# Common application-form questions that aren't covered by the standard
# Greenhouse fields. Set these to keep the AI from being asked at all.
APPLICANT_REFERRAL_SOURCE=
APPLICANT_SECURITY_CLEARANCE=

# Free-text "candidate summary" injected into the AI prompt so generated
# answers match your real background. Keep it concise; a paragraph is fine.
APPLICANT_SUMMARY=Senior software engineer with 8+ years of experience building backend systems in Python and TypeScript. Comfortable with cloud (AWS/GCP), distributed systems, and remote async collaboration.


# ---------------------------------------------------------------------------
# AI for answering free-form application questions (cover-letter style /
# "why are you a fit?" / open-ended). Only used when a question is detected
# that isn't covered by the profile fields above.
# ---------------------------------------------------------------------------

# Set to 'openai' to enable, or leave blank to skip AI answers entirely
# (unknown questions will be left blank with a warning).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Path to the editable prompt template used for AI answers.
AI_PROMPT_FILE=ai_prompt.txt
